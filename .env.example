# Copy to .env.local (gitignored) and fill in. This file is a template — NO real keys.

# App (client). Only VITE_-prefixed vars are bundled into the browser.
# The anon key is designed to be public; safe in the client.
VITE_SUPABASE_URL=https://<your-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon public key>

# Web Push (migration 026). Optional — leave blank and the "notify me on this device"
# toggle stays disabled; SMS and in-app notifications are unaffected.
# The PUBLIC half is public by design (it's what the browser encrypts to). The private
# half belongs in the dispatch-notifications Edge Function's secrets, never here.
# Generate a pair with:  npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Seed / Edge Functions ONLY — the service_role key bypasses RLS. Never commit it and
# never prefix it with VITE_ (that would leak it to the client bundle). Provide it via
# shell env at run time instead of storing it in a file:
#   $env:SUPABASE_URL="https://<your-ref>.supabase.co"
#   $env:SUPABASE_SERVICE_ROLE_KEY="<service_role secret>"
